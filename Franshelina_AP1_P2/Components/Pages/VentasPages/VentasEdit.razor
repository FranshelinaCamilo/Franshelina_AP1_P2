@page "/Ventas/Edit/{VentaId:int}"
@rendermode InteractiveServer
@inject ProductosService productosService
@inject VentasService ventasService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Editar Venta</PageTitle>

<EditForm Model="Venta" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Editar Venta</h5>
            </div>

            <div class="card-body">
                <div class="d-flex justify-content-between">
                    @* VentaId *@
                    <div class="mb-3">
                        <label class="form-label"><strong>VentaId</strong></label>
                        <InputNumber class="form-control" @bind-Value="Venta.VentaId" readonly />
                    </div>

                    @* Fecha *@
                    <div class="mb-3">
                        <label class="form-label"><strong>Fecha</strong></label>
                        <InputDate class="form-control" @bind-Value="Venta.Fecha"></InputDate>
                        <ValidationMessage For="@(() => Venta.Fecha)" />
                    </div>
                </div>

                @* Observacion *@
                <div class="mb-3">
                    <label class="form-label"><strong>Observacion</strong></label>
                    <InputText class="form-control" @bind-Value="Venta.Observacion" />
                    <ValidationMessage For="@(() => Venta.Observacion)" />
                </div>

                @* Detalles de la Venta *@
                <div class="border border-success p-3 mt-3">
                    <h5>Detalles de la Venta</h5>

                    <ProductosPicker Productos="ListaProductos"
                                     ProductoId="DetalleSeleccionado.ProductoId"
                                     Cantidad="DetalleSeleccionado.Cantidad"
                                     OnProductoSelected="HandleProductoSelected" />

                    <div class="mb-3 mt-2">
                        <label class="form-label"><strong>Precio del Producto</strong></label>
                        <label class="form-control">@ProductoSeleccionado?.Precio</label>
                    </div>

                    <hr />

                    <table class="table table-light">
                        <thead class="table table-striped">
                            <tr class="text-center">
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio</th>
                                <th>Subtotal</th>
                                <th>Remover</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            @foreach (var detalle in Venta.VentasDetalle)
                            {
                                <tr>
                                    <td>@(detalle.Producto?.Descripcion ?? ObtenerNombreProducto(detalle.ProductoId))</td>
                                    <td>@detalle.Cantidad</td>
                                    <td>@detalle.Precio</td>
                                    <td>@(detalle.Cantidad * detalle.Precio)</td>
                                    <td>
                                        <button type="button" class="btn btn-outline-danger bi bi-trash"
                                                @onclick="() => RemoverDetalle(detalle)">
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <hr />
                </div>

                @* Total *@
                <div class="row mt-2">
                    <div class="col-6 offset-6">
                        <div class="mb-3">
                            <label class="form-label"><strong>Total de la Venta</strong></label>
                            <label class="form-control text-end"><strong>@Venta.Total</strong></label>
                            <ValidationMessage For="@(() => Venta.Total)" />
                        </div>
                    </div>
                </div>
            </div>

            @* footer *@
            <div class="card-footer text-center mt-2">
                <a href="/Ventas/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
                <button type="button" class="btn btn-danger bi bi-trash" @onclick="Eliminar"> Eliminar </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int VentaId { get; set; }

    public Ventas Venta { get; set; } = new Ventas();
    public VentasDetalle DetalleSeleccionado { get; set; } = new();
    public List<Productos> ListaProductos { get; set; } = [];
    public Productos? ProductoSeleccionado { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var resultProductos = await productosService.GetList(p => true);
        resultProductos.OnSuccess(lista => ListaProductos = lista);

        var resultVenta = await ventasService.Buscar(VentaId);
        resultVenta.OnSuccess(v =>
        {
            if (v != null)
            {
                Venta = v;
                Venta.VentasDetalle ??= new List<VentasDetalle>();
            }
        });

        DetalleSeleccionado.Cantidad = 1;
    }

    private async Task HandleProductoSelected((Productos producto, int cantidad) selection)
    {
        ProductoSeleccionado = selection.producto;

        var yaExiste = Venta.VentasDetalle.FirstOrDefault(p =>
            p.ProductoId == selection.producto.ProductoId);

        if (yaExiste != null)
        {
            yaExiste.Cantidad += selection.cantidad;
        }
        else
        {
            var detalle = new VentasDetalle
            {
                VentaId = Venta.VentaId,
                ProductoId = selection.producto.ProductoId,
                Cantidad = selection.cantidad,
                Precio = selection.producto.Precio,
                Producto = selection.producto
            };

            Venta.VentasDetalle.Add(detalle);
        }

        Venta.Total = Venta.VentasDetalle.Sum(d => d.Cantidad * d.Precio);

        DetalleSeleccionado = new VentasDetalle { Cantidad = 1 };

        await Task.CompletedTask;
    }

    public async Task Modificar()
    {
        if (Venta.VentasDetalle == null || !Venta.VentasDetalle.Any())
        {
            toastService.ShowError("Debe agregar por lo menos un producto en el detalle de la venta.");
            return;
        }

        Venta.Total = Venta.VentasDetalle.Sum(d => d.Cantidad * d.Precio);

        var result = await ventasService.Guardar(Venta);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Venta modificada correctamente.");
            navigationManager.NavigateTo("/Ventas/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("No se pudo modificar la venta.");
        });
    }

    public async Task Eliminar()
    {
        var result = await ventasService.Eliminar(Venta.VentaId);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Venta eliminada correctamente.");
            navigationManager.NavigateTo("/Ventas/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("No se pudo eliminar la venta.");
        });
    }

    public void RemoverDetalle(VentasDetalle detalle)
    {
        Venta.VentasDetalle.Remove(detalle);

        Venta.Total = Venta.VentasDetalle.Sum(d => d.Cantidad * d.Precio);

        DetalleSeleccionado = detalle;
        ProductoSeleccionado = detalle.Producto;
    }

    private string ObtenerNombreProducto(int productoId)
    {
        return ListaProductos.FirstOrDefault(p => p.ProductoId == productoId)?.Descripcion
            ?? $"Producto #{productoId}";
    }
}
